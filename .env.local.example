# Supabase — obtener en https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Sólo en servidor; nunca exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Enriquecimiento de metadatos de libros (feature 002) — sólo servidor; nunca NEXT_PUBLIC_
GOOGLE_BOOKS_API_KEY=tu-api-key-de-google-books
# Opcional: contacto para el User-Agent de Open Library (sube el límite a 3 req/s)
OPEN_LIBRARY_CONTACT=tu-email@ejemplo.com
# Sólo para pruebas e2e: 1 = no llamar a Open Library / Google Books tras importar
# ENRICHMENT_DISABLED=1
